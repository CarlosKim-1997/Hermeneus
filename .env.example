DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hermeneus
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hermeneus_test

# Live Handoff extraction (server-only; optional — manual Creator workflow works without these)
OPENAI_API_KEY=
OPENAI_MODEL=

# Receiver interpretation: deterministic (default) or openai (requires OPENAI_* above)
RECEIVER_INTERPRETER=deterministic

# Receiver answer expression: deterministic (default) or openai-grounded (requires OPENAI_*; independent of RECEIVER_INTERPRETER)
RECEIVER_ANSWER_MODE=deterministic

# Creator auth: disabled (default) or dev (local/E2E only; refused when NODE_ENV=production)
CREATOR_AUTH_MODE=disabled
DEV_CREATOR_ID=
CREATOR_SESSION_SECRET=

# Deterministic extraction for Playwright (no OpenAI key required)
# HERMENEUS_EXTRACTION_FIXTURE=e2e
