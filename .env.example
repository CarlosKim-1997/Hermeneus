DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hermeneus
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hermeneus_test

# Legacy server generation only; leave unset for the personal-AI Sender/Receiver workflow.
# The verifier credential alone must never enable source extraction or server answer generation.
OPENAI_EXTRACTION_API_KEY=
OPENAI_MODEL=

# External answer verifier pilot only. Use a dedicated OpenAI project/key with its own project spend cap.
# It stays disabled unless both the mode and key are set. Its model is pinned to gpt-6.1-sol.
HERMENEUS_EXTERNAL_VERIFIER=off
OPENAI_API_KEY=
# Optional bounded smoke: configure BOTH, using current UTC YYYY-MM and a reduced
# monthly reservation ceiling (5..2500 cents). Partial/expired settings deny calls.
# HERMENEUS_VERIFIER_SMOKE_MONTH=2026-10
# HERMENEUS_VERIFIER_SMOKE_LIMIT_CENTS=25

# Receiver interpretation: deterministic (default) or openai (requires OPENAI_EXTRACTION_API_KEY and OPENAI_MODEL)
RECEIVER_INTERPRETER=deterministic

# Receiver answer expression: deterministic (default) or openai-grounded (requires OPENAI_EXTRACTION_API_KEY and OPENAI_MODEL; independent of RECEIVER_INTERPRETER)
RECEIVER_ANSWER_MODE=deterministic

# Creator auth: disabled (default) or dev (local/E2E only; refused when NODE_ENV=production)
CREATOR_AUTH_MODE=disabled
DEV_CREATOR_ID=
CREATOR_SESSION_SECRET=

# External identity (CREATOR_AUTH_MODE=external)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set AUTH_TRUST_HOST=true only when the deployment platform or reverse proxy sanitizes Host/X-Forwarded-Host headers.
# AUTH_TRUST_HOST=

# Deterministic extraction for Playwright (no OpenAI key required)
# HERMENEUS_EXTRACTION_FIXTURE=e2e
